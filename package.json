{
  "name": "career-ops",
  "version": "1.8.1",
  "description": "AI-powered job search pipeline built on Claude Code",
  "scripts": {
    "doctor": "node doctor.mjs",
    "verify": "node verify-pipeline.mjs",
    "normalize": "node normalize-statuses.mjs",
    "dedup": "node dedup-tracker.mjs",
    "merge": "node merge-tracker.mjs",
    "pdf": "node generate-pdf.mjs",
    "sync-check": "node cv-sync-check.mjs",
    "update:check": "node update-system.mjs check",
    "update": "node update-system.mjs apply",
    "rollback": "node update-system.mjs rollback",
    "liveness": "node check-liveness.mjs",
    "scan": "node scan.mjs",
    "patterns": "node analyze-patterns.mjs",
    "gemini:eval": "node gemini-eval.mjs",
    "gmail:sync": "node gmail-sync.mjs",
    "gmail:qa": "node --no-warnings test-gmail-sync.mjs",
    "eval:qa": "node test-evaluation-guardrails.mjs",
    "scan:qa": "node --no-warnings test-scan-utils.mjs",
    "contacts:qa": "node --no-warnings test-contact-intel.mjs",
    "apply:qa": "node --no-warnings test-apply-assistant.mjs",
    "email:qa": "node --no-warnings test-apply-email.mjs",
    "docs:qa": "node --no-warnings test-document-content.mjs",
    "length:qa": "node --no-warnings test-resume-length.mjs"
  },
  "keywords": [
    "ai",
    "job-search",
    "claude-code",
    "career",
    "automation"
  ],
  "author": "Santiago Fernández de Valderrama <hi@santifer.io> (https://santifer.io)",
  "homepage": "https://santifer.io",
  "repository": {
    "type": "git",
    "url": "https://github.com/santifer/career-ops"
  },
  "license": "MIT",
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "dotenv": "^17.0.0",
    "imapflow": "^1.6.5",
    "js-yaml": "^5.3.0",
    "mailparser": "^3.9.14",
    "playwright": "^1.58.1"
  }
}
